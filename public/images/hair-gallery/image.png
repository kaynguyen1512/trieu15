  const MIN_WIDTH = 360;
  const meta = document.querySelector('meta[name="viewport"]');

  if (!meta) {
    return;
  }

  function update() {
    /**
     * Never let the layout drop below the min width: on narrower screens the
     * browser scales the page down to fit instead of reflowing or scrolling.
